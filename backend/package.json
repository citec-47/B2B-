{
  "name": "e-shop-multi-vendor",
  "version": "1.0.0",
  "main": "server.js",
  "engines": {
    "node": ">=18.16.0",
    "npm": ">=9.5.0"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "start:dev": "NODE_ENV=development nodemon server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "debug": "NODE_ENV=development node --inspect server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "heroku-postbuild": "NPM_CONFIG_PRODUCTION=false",
    "docker:build": "docker build -t e-shop-backend .",
    "docker:run": "docker run -p 5000:5000 --env-file .env e-shop-backend",
    "db:local": "docker run -d -p 27017:27017 --name mongodb-local mongo:latest",
    "db:stop": "docker stop mongodb-local && docker rm mongodb-local"
  },
  "keywords": [
    "e-commerce",
    "mern",
    "multi-vendor",
    "shop"
  ],
  "author": "Om Prakash Pattjoshi",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.12",
    "socket.io": "^4.8.3",
    "stripe": "^12.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  },
  "description": "Multi-vendor E-commerce platform with real-time features",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/e-shop-multi-vendor.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/e-shop-multi-vendor/issues"
  },
  "homepage": "https://github.com/yourusername/e-shop-multi-vendor#readme"
}